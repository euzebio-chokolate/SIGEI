# =============================================================================
# SIGEI Backend — exemplo de configuração
# Copie para .env na raiz do projeto e troque os valores marcados.
# Nunca versione o .env com credenciais reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=sigei
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
# Porta publicada pelo contêiner do PostgreSQL no Docker Compose
POSTGRES_PORT=5432

# Execução fora do Docker: URL JDBC e credenciais (usam POSTGRES_* quando omitidas).
# No Docker Compose, a URL é montada automaticamente para o serviço "postgres".
# DATABASE_URL=jdbc:postgresql://localhost:5432/sigei
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=troque-esta-senha
# DATABASE_POOL_SIZE=10
# DATABASE_POOL_MIN_IDLE=1

# O esquema é criado e atualizado pelo Flyway (src/main/resources/db/migration).
# O Hibernate apenas valida as entidades; não use "update".
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false

# -----------------------------------------------------------------------------
# Autenticação (JWT + refresh token)
# -----------------------------------------------------------------------------
# Obrigatório. Segredo HMAC com pelo menos 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Validade do token de acesso, em milissegundos. Padrão: 900000 (15 minutos).
# Ao expirar, o frontend renova a sessão automaticamente com o refresh token.
JWT_EXPIRATION=900000

# Validade do refresh token, em milissegundos. Padrão: 604800000 (7 dias).
# Após esse período sem renovação, o usuário precisa entrar novamente.
JWT_REFRESH_EXPIRATION=604800000

# Os tokens são entregues em cookies HttpOnly (inacessíveis a scripts) e SameSite=Strict.
# true: cookies só trafegam por HTTPS (obrigatório em produção). Navegadores aceitam
# cookies seguros em http://localhost, mas não em http://IP-da-rede; nesse caso use false.
# O frontend deve acessar a API pela mesma origem (proxy /api).
SIGEI_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Dados sensíveis dos professores (CPF, matrícula e número do contrato)
# -----------------------------------------------------------------------------
# Cifra em envelope: os campos são cifrados por uma chave de dados guardada no
# banco, que por sua vez é cifrada pela chave mestra e pela chave de recuperação.
# Procedimentos de troca e recuperação: docs/CHAVES_DADOS_SENSIVEIS.md
#
# Obrigatório. Chave mestra, com pelo menos 32 bytes aleatórios em Base64.
# Gere com: openssl rand -base64 32. Trocá-la não exige recifrar os dados.
SIGEI_CHAVE_DADOS_SENSIVEIS=troque-pela-saida-de-openssl-rand-base64-32

# Recomendado. Chave pública RSA (3072 bits ou mais), em Base64 do DER, que guarda
# uma cópia da chave de dados. Com a chave privada correspondente, guardada fora do
# servidor, os dados são recuperáveis mesmo se a chave mestra se perder.
SIGEI_CHAVE_RECUPERACAO_PUBLICA=

# Só durante uma troca de chave mestra: a chave antiga. Remova depois de reiniciar.
# SIGEI_CHAVE_DADOS_SENSIVEIS_ANTERIOR=

# Só para recuperar após perder a chave mestra: a chave privada de recuperação
# (PKCS#8 em Base64). Remova imediatamente depois de reiniciar.
# SIGEI_CHAVE_RECUPERACAO_PRIVADA=

# -----------------------------------------------------------------------------
# Administrador inicial (criado apenas se o e-mail ainda não existir)
# -----------------------------------------------------------------------------
SIGEI_ADMIN_NAME=Administrador
SIGEI_ADMIN_EMAIL=admin@sigei.com
# Obrigatório no Docker Compose. Fora dele, se vazio, uma senha temporária é gerada e registrada no log.
SIGEI_ADMIN_PASSWORD=troque-esta-senha

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# URL pública do frontend, sem barra no final. Separe múltiplas origens por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://172.16.46.41:4200

# -----------------------------------------------------------------------------
# Armazenamento de imagens (Cloudinary)
# -----------------------------------------------------------------------------
# Vazios ou "disabled": a API funciona, mas o envio de fotos responde 503.
# No cadastro completo de escola, enviar foto sem Cloudinary desfaz todo o cadastro.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Porta local da API (padrão 8080). No Docker Compose, é a porta publicada no host.
PORT=8081
